### (d) Create four integers, four pointers to these integers and four references to them. Store these pointers and references in two arrays and print out the values of four integers using these arrays.

**Answer:**
```cpp
#include <bits/stdc++.h>
using namespace std;

int main() {
    int a = 10, b = 20, c = 30, d = 40;
    int *p = &a, *q = &b, *r = &c, *s = &d;
    int &w = a,  &x = b,  &y = c,  &z = d;

    int *num_ptr[] = {p, q, r, s}; // Array of pointers
    int *num_ref[] = {&w, &x, &y, &z}; // Array of references

    cout << "Values using references array:" << endl;
    for (int i = 0; i < 4; i++) {
        cout << **(num_ref + i) << endl;
    }
    
    cout << "Values using pointer array:" << endl;
    for (int i = 0; i < 4; i++) {
        cout << **(num_ptr + i) << endl;
    }
}
```

